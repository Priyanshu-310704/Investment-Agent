# Required - Groq API Key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional - Groq LLM model. Use any chat model available to your account.
GROQ_MODEL=llama-3.3-70b-versatile

# Required - Neon Postgres Database URL (Pooled URL is auto-injected by Vercel)
# Format: postgres://username:password@hostname/databasename?sslmode=require
DATABASE_URL=your_postgres_database_url_here
